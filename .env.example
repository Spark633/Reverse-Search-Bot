# Pflicht: Token von @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# Stark empfohlen: kostenloser API-Key von https://saucenao.com/user.php?page=search-api
# (ohne Key wird SauceNAO übersprungen)
SAUCENAO_API_KEY=

# Kommagetrennte Telegram-User-IDs, die den Bot nutzen dürfen (leer = alle).
# Deine ID bekommst du z. B. über @userinfobot. Für einen NSFW-Bot empfohlen!
ALLOWED_USER_IDS=

# Treffer unter dieser Ähnlichkeit (in %) werden ausgeblendet
MIN_SIMILARITY=60
# Maximale Anzahl angezeigter Treffer
MAX_RESULTS=8

# Einzelne Suchmaschinen an/aus
ENABLE_SAUCENAO=true
ENABLE_IQDB=true
ENABLE_FLUFFLE=true

# Bild kurzzeitig (1h) bei litterbox.catbox.moe hochladen, damit Buttons für
# Google Lens, Yandex, Bing, TinEye und ascii2d erzeugt werden können.
# "none" deaktiviert das (dann gibt es keine Links zu diesen Diensten).
PUBLIC_UPLOAD=litterbox

# Kontakt für den User-Agent (Fluffle verlangt einen identifizierbaren User-Agent)
CONTACT=your-telegram-or-github-name
